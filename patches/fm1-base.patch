diff --git a/bt/br/bt_avdtp.c b/bt/br/bt_avdtp.c
index 8ff9fef..2b4db61 100644
--- a/bt/br/bt_avdtp.c
+++ b/bt/br/bt_avdtp.c
@@ -78,3 +78,122 @@ uint32_t bv_setconf_par(uint8_t *out, uint32_t acp, uint32_t intseid, const uint
         out[k++] = conf[i];
     return k;
 }
+
+/* ---- the acceptor */
+static const uint8_t BV_SEP_CAPS[10] = {1, 0, 7, 6, 0x00, 0x00, 0x21, 0x15, 2, 53};   /* media transport; SBC: 44.1 kHz
+                                                    * joint stereo; 16 blocks, 8 subbands, loudness; bitpool 2..53 */
+#define BV_E_BAD_ACP_SEID 0x12u
+#define BV_E_SEP_IN_USE 0x13u
+#define BV_E_NOT_SUPPORTED 0x19u
+#define BV_E_UNSUPPORTED_CONF 0x29u
+#define BV_E_BAD_STATE 0x31u
+
+static uint32_t bv_ans(uint8_t *out, uint32_t label, uint32_t msg, uint32_t sig, const uint8_t *par, uint32_t n)
+{
+    uint32_t i;
+    out[0] = (uint8_t)((label & 15u) << 4 | msg);
+    out[1] = (uint8_t)(sig & 0x3Fu);
+    for (i = 0; i < n && i < 14u; i++)
+        out[2 + i] = par[i];
+    return 2u + i;
+}
+/* a reject: the error, after the service category (SET_CONFIGURATION, RECONFIGURE) or the SEID (START, SUSPEND) */
+static uint32_t bv_rej(uint8_t *out, uint32_t label, uint32_t sig, int pre, uint32_t err)
+{
+    uint8_t par[2];
+    uint32_t k = 0;
+    if (pre >= 0)
+        par[k++] = (uint8_t)pre;
+    par[k++] = (uint8_t)err;
+    return bv_ans(out, label, BV_REJECT, sig, par, k);
+}
+
+uint32_t bv_acp(const uint8_t *p, uint32_t n, struct bv_sep *s, uint8_t *out, uint32_t *ev)
+{
+    uint32_t label, msg, sig, seid, i;
+    uint8_t par[10], sbc[4];
+    *ev = BV_EV_NONE;
+    if (!bv_hdr(p, n, &label, &msg, &sig) || msg != BV_CMD)
+        return 0;
+    seid = n > 2u ? (uint32_t)p[2] >> 2 : 0u;
+    switch (sig) {
+    case BV_DISCOVER:                              /* our end-point: SEID, in use; audio, a source */
+        par[0] = (uint8_t)(BV_SEID << 2 | (s->used ? 2u : 0u));
+        par[1] = 0x00;
+        return bv_ans(out, label, BV_ACCEPT, sig, par, 2);
+    case BV_GET_CAPS:
+    case BV_GET_ALL_CAPS:
+        if (seid != BV_SEID)
+            return bv_rej(out, label, sig, -1, BV_E_BAD_ACP_SEID);
+        return bv_ans(out, label, BV_ACCEPT, sig, BV_SEP_CAPS, sizeof BV_SEP_CAPS);
+    case BV_SET_CONF:
+        if (seid != BV_SEID)
+            return bv_rej(out, label, sig, 0, BV_E_BAD_ACP_SEID);
+        if (s->used)
+            return bv_rej(out, label, sig, 0, BV_E_SEP_IN_USE);
+        if (n < 4u || !bv_caps_sbc(p + 2, n - 2u, sbc))
+            return bv_rej(out, label, sig, 7, BV_E_UNSUPPORTED_CONF);
+        if ((sbc[0] & 0xF0u) != 0x20u || (sbc[0] & 0x0Fu) != 0x01u || (sbc[1] & 0xF0u) != 0x10u ||
+            (sbc[1] & 0x0Cu) != 0x04u || (sbc[1] & 0x03u) != 0x01u || sbc[2] < 2u || sbc[2] > sbc[3])
+            return bv_rej(out, label, sig, 7, BV_E_UNSUPPORTED_CONF);   /* (what the encoder cannot make) */
+        for (i = 0; i < 4u; i++)
+            s->conf[i] = sbc[i];
+        s->peer = (uint8_t)(p[3] >> 2);
+        s->used = s->by_dev = 1;
+        s->opened = s->started = 0;
+        *ev = BV_EV_CONF;
+        return bv_ans(out, label, BV_ACCEPT, sig, 0, 0);
+    case BV_GET_CONF:
+        if (seid != BV_SEID)
+            return bv_rej(out, label, sig, -1, BV_E_BAD_ACP_SEID);
+        if (!s->used)
+            return bv_rej(out, label, sig, -1, BV_E_BAD_STATE);
+        for (i = 0; i < 6u; i++)
+            par[i] = BV_SEP_CAPS[i];
+        for (i = 0; i < 4u; i++)
+            par[6 + i] = s->conf[i];
+        return bv_ans(out, label, BV_ACCEPT, sig, par, 10);
+    case BV_OPEN:
+        if (seid != BV_SEID)
+            return bv_rej(out, label, sig, -1, BV_E_BAD_ACP_SEID);
+        if (!s->used || s->opened)
+            return bv_rej(out, label, sig, -1, BV_E_BAD_STATE);
+        s->opened = 1;
+        *ev = BV_EV_OPEN;
+        return bv_ans(out, label, BV_ACCEPT, sig, 0, 0);
+    case BV_START:
+        if (seid != BV_SEID)
+            return bv_rej(out, label, sig, (int)(seid << 2), BV_E_BAD_ACP_SEID);
+        if (!s->used || !s->media)
+            return bv_rej(out, label, sig, (int)(seid << 2), BV_E_BAD_STATE);
+        s->started = 1;
+        *ev = BV_EV_START;
+        return bv_ans(out, label, BV_ACCEPT, sig, 0, 0);
+    case BV_SUSPEND:
+        if (seid != BV_SEID)
+            return bv_rej(out, label, sig, (int)(seid << 2), BV_E_BAD_ACP_SEID);
+        if (!s->started)
+            return bv_rej(out, label, sig, (int)(seid << 2), BV_E_BAD_STATE);
+        s->started = 0;
+        *ev = BV_EV_SUSPEND;
+        return bv_ans(out, label, BV_ACCEPT, sig, 0, 0);
+    case BV_CLOSE:
+        if (seid != BV_SEID)
+            return bv_rej(out, label, sig, -1, BV_E_BAD_ACP_SEID);
+        if (!s->used)
+            return bv_rej(out, label, sig, -1, BV_E_BAD_STATE);
+        s->used = s->by_dev = s->opened = s->started = 0;
+        *ev = BV_EV_CLOSE;
+        return bv_ans(out, label, BV_ACCEPT, sig, 0, 0);
+    case BV_ABORT:                                 /* (never rejected: AVDTP 1.3 §8.16) */
+        s->used = s->by_dev = s->opened = s->started = 0;
+        *ev = BV_EV_CLOSE;
+        return bv_ans(out, label, BV_ACCEPT, sig, 0, 0);
+    case BV_DELAY:                                 /* its delay report: taken */
+        return bv_ans(out, label, BV_ACCEPT, sig, 0, 0);
+    case BV_RECONF:
+        return bv_rej(out, label, sig, 7, BV_E_NOT_SUPPORTED);
+    default:                                       /* SECURITY_CONTROL and what we do not know */
+        return bv_rej(out, label, sig, -1, BV_E_NOT_SUPPORTED);
+    }
+}
diff --git a/bt/br/bt_avdtp.h b/bt/br/bt_avdtp.h
index 15b8c07..7ede90d 100644
--- a/bt/br/bt_avdtp.h
+++ b/bt/br/bt_avdtp.h
@@ -6,7 +6,8 @@
 #define BT_AVDTP_H
 #include <stdint.h>
 
-enum { BV_DISCOVER = 1, BV_GET_CAPS = 2, BV_SET_CONF = 3, BV_OPEN = 6, BV_START = 7, BV_CLOSE = 8, BV_SUSPEND = 9 };
+enum { BV_DISCOVER = 1, BV_GET_CAPS = 2, BV_SET_CONF = 3, BV_GET_CONF = 4, BV_RECONF = 5, BV_OPEN = 6, BV_START = 7,
+       BV_CLOSE = 8, BV_SUSPEND = 9, BV_ABORT = 10, BV_SECURITY = 11, BV_GET_ALL_CAPS = 12, BV_DELAY = 13 };
 enum { BV_CMD = 0, BV_ACCEPT = 2, BV_REJECT = 3 };
 
 /* a single-packet command: label 0-15, signal id, parameters -> its length in out */
@@ -23,4 +24,23 @@ int bv_sbc_choose(const uint8_t cap[4], uint8_t conf[4]);
 /* SET_CONFIGURATION's parameters (ACP SEID, INT SEID, media transport, SBC codec) -> their length */
 uint32_t bv_setconf_par(uint8_t *out, uint32_t acp, uint32_t intseid, const uint8_t conf[4]);
 
+/* The acceptor (AVDTP 1.3 §8, the device's own commands): many sinks discover, configure and open the stream
+ * themselves once the signalling channel is up, the source answering, as phones and computers do. Our one stream
+ * end-point, BV_SEID: an audio source of SBC at what the encoder makes (44.1 kHz, joint stereo, 16 blocks, 8
+ * subbands, loudness, bitpool 2..53). */
+#define BV_SEID 1u
+struct bv_sep {
+    uint8_t used;                                  /* configured (by the device, or by our SET_CONFIGURATION) */
+    uint8_t by_dev;                                /* configured by the device: the set-up is its */
+    uint8_t opened;                                /* OPEN accepted: its media channel comes */
+    uint8_t media;                                 /* the media channel is open (the caller's to set) */
+    uint8_t started;                               /* streaming */
+    uint8_t peer;                                  /* the device's SEID (its INT SEID in SET_CONFIGURATION) */
+    uint8_t conf[4];                               /* the SBC configuration */
+};
+enum { BV_EV_NONE, BV_EV_CONF, BV_EV_OPEN, BV_EV_START, BV_EV_SUSPEND, BV_EV_CLOSE };
+/* a command from the device (p, n: the whole PDU) -> our answer's PDU in out (its length, 0: none), the end-point
+ * updated, *ev what changed (BV_EV_*). out: 16 bytes */
+uint32_t bv_acp(const uint8_t *p, uint32_t n, struct bv_sep *s, uint8_t *out, uint32_t *ev);
+
