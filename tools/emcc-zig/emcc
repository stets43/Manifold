#!/usr/bin/env python3
# SPDX-License-Identifier: MPL-2.0
# A stand-in for Emscripten's emcc for fm1-base's --web build: the same C, compiled by zig's clang to wasm32-wasi
# (its wasi-libc), linked as a reactor that exports every function marked visibility("default").
import subprocess, sys
args, out, link = [], [], True
skip_next = False
for i, a in enumerate(sys.argv[1:]):
    if skip_next: skip_next = False; continue
    if a == "--version": print("emcc (zig cc stand-in)"); sys.exit(0)
    if a == "-c": link = False
    if a.startswith("-sSTACK_SIZE="): out.append(f"-Wl,-z,stack-size={a.split('=')[1]}"); continue
    if a.startswith("-sINITIAL_MEMORY="): out.append(f"-Wl,--initial-memory={a.split('=')[1]}"); continue
    if a.startswith("-s") and not a.startswith("-std"): continue      # (other Emscripten settings: nothing to do)
    if a == "--no-entry": continue
    args.append(a)
cmd = [sys.executable, "-m", "ziglang", "cc", "-target", "wasm32-wasi", "-fno-sanitize=undefined", *args]
if link:
    cmd += ["-mexec-model=reactor", "-Wl,--export-dynamic", *out]
sys.exit(subprocess.run(cmd).returncode)
